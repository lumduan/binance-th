# Binance Thailand API credentials — copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.
#
# BinanceThConfig (pydantic-settings) reads these with the BINANCE_TH_ prefix,
# so the variable names MUST be prefixed exactly as below:

BINANCE_TH_API_KEY=your_api_key_here
BINANCE_TH_API_SECRET=your_api_secret_here

# Optional overrides (defaults shown):
# BINANCE_TH_REST_BASE_URL=https://api.binance.th
# BINANCE_TH_RECV_WINDOW=5000
# BINANCE_TH_USER_STREAM_KEEPALIVE_INTERVAL=1200

# For opt-in live tests (never run in CI):
# BINANCE_TH_LIVE=1
